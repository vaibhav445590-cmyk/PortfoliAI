# PortfoliAI — Environment Configuration Template
# Copy this file to .env and adjust values for your local or production environment.

# Flask Application Settings
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=change_this_to_a_secure_random_string_in_production
JWT_SECRET_KEY=change_this_to_a_secure_jwt_secret_in_production
JWT_EXPIRATION_HOURS=24

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=student_portfolio
DB_USER=postgres
DB_PASSWORD=your_db_password_here
# Optional: Complete connection string for Docker / Cloud hosting
# DATABASE_URL=postgresql://postgres:password@localhost:5432/student_portfolio

# Upload Restrictions
UPLOAD_FOLDER=uploads/resumes
MAX_CONTENT_LENGTH=10485760

# AI Provider Settings
# Options: local (guaranteed offline free fallback), openai, ollama
AI_PROVIDER=local
AI_TIMEOUT_SECONDS=15
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_HOST=http://localhost:11434

# Rate Limiting & Abuse Protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
