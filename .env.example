# PortfoliAI — Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# Never commit real credentials or .env to version control.

# Flask Application Settings
FLASK_ENV=
FLASK_DEBUG=
SECRET_KEY=
JWT_SECRET_KEY=
JWT_EXPIRATION_HOURS=

# PostgreSQL Database Configuration
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DATABASE_URL=

# Upload Restrictions
UPLOAD_FOLDER=
MAX_CONTENT_LENGTH=

# AI Provider Settings
# Options: local, openai, ollama
AI_PROVIDER=
AI_TIMEOUT_SECONDS=
OPENAI_API_KEY=
OLLAMA_HOST=

# Rate Limiting & Abuse Protection
RATE_LIMIT_ENABLED=
RATE_LIMIT_PER_MINUTE=

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=
